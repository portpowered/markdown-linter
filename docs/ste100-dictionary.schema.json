{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "marklint STE100 dictionary",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "words": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "word"
        ],
        "properties": {
          "word": {
            "type": "string",
            "minLength": 1
          },
          "forms": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "meaning": {
            "type": "string",
            "minLength": 1
          },
          "part-of-speech": {
            "enum": [
              "noun",
              "verb",
              "adjective",
              "adverb",
              "pronoun",
              "preposition",
              "conjunction",
              "determiner",
              "interjection"
            ]
          }
        }
      }
    },
    "technical-terms": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "alternatives": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "anyOf": [
    {
      "required": [
        "words"
      ],
      "properties": {
        "words": {
          "minItems": 1
        }
      }
    },
    {
      "required": [
        "entries"
      ],
      "properties": {
        "entries": {
          "minItems": 1
        }
      }
    },
    {
      "required": [
        "technical-terms"
      ],
      "properties": {
        "technical-terms": {
          "minItems": 1
        }
      }
    }
  ]
}
